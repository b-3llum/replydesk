# Copy to .env. Empty values fall through to the environment / setx values.
# .env is read once at startup: restart the server after changing it.

# Luminal (OpenAI-compatible): run.py generate, Reply Studio, smoke.py llm
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_API_KEY=
LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Apify API token: run.py scrape (not needed with --from-cache)
APIFY_TOKEN=

# MongoDB Atlas connection string. Empty = the JSON store (data/store.json)
MONGODB_URI=

# Public https URL of this app, used in preview links and outreach texts.
# Required by the admin Businesses/Outreach pages, the CSV export and run.py outreach.
PUBLIC_BASE_URL=

# Stripe payment link; client_reference_id=<slug> is appended. Empty = the Unlock buttons go nowhere.
# In Stripe, send buyers to <PUBLIC_BASE_URL>/thanks after payment.
PAYMENT_LINK=

# Admin sign-in key for /admin. Empty = the admin stays locked.
ADMIN_KEY=

# Demo mode: 1 = "Take the tour" on the home page and the admin opens without a key.
# Never on the public URL. Off unless set; use 0 to override a value set with setx.
DEMO_MODE=

# Optional store override: json | mongo. Empty (or auto) = mongo when MONGODB_URI is set, else json.
REPLYDESK_STORE=
# Optional: JSON store file, relative to this folder. Default data/store.json
REPLYDESK_JSON_PATH=
# Optional: MongoDB database name. Default replydesk
REPLYDESK_MONGO_DB=
